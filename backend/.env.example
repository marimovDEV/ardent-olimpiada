# Django
# Lokal development uchun True, production'da MUTLAQO False (yoki umuman yozmang)
DEBUG=False
# Production'da majburiy. Yangi kalit: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ESKIZ SMS API (https://eskiz.uz)
ESKIZ_EMAIL=your_eskiz_email@example.com
ESKIZ_PASSWORD=your_eskiz_api_password

# PostgreSQL — POSTGRES_DB berilmasa SQLite ishlatiladi (lokal dev).
# Production'da to'ldirish SHART: olimpiada yuklamasida SQLite yetmaydi.
# psycopg[binary] paketi ham kerak (requirements.txt ga qo'shilgan).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Proxy orqasida HTTPS redirect / HSTS (ehtiyot bilan yoqing)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
